NODE_ENV=development
PORT=4000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the service-account JSON as one line in your hosting provider's secret environment variable.
# Keep this empty locally if using `gcloud auth application-default login` instead.
FIREBASE_KEY=

# JSON object: producer ID -> key ID -> 32+ byte shared secret.
# Use a secret manager in production; do not commit real values.
PRODUCER_KEYS_JSON={"cycling-club-manager":{"key-2026-01":"replace-with-a-long-random-secret"}}
REVIEWER_KEYS_JSON={"audit-reviewer":{"key-2026-01":"replace-with-another-long-random-secret"}}

# Create an Ed25519 key pair for signing receipts. Preserve old public keys during rotation.
RECEIPT_KEY_ID=receipt-key-2026-01
RECEIPT_SIGNING_PRIVATE_KEY=
RECEIPT_PUBLIC_KEYS_JSON={}

MAX_EVENTS_PER_BATCH=100
MAX_EVENT_BODY_BYTES=262144
AUTH_CLOCK_SKEW_SECONDS=300
NONCE_TTL_SECONDS=900
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
